{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wordpress-test/benefits-grid",
	"version": "0.1.0",
  "title": "Benefits Grid",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Benefits grid with filtering",
  "example": {},
  "attributes": {
    "fontSize": {
      "type": "number",
      "default": 16
    },
    "backgroundColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "gradient": {
      "type": "string",
      "default": ""
    }
  },
	"supports": {
		"html": false,
    "color": {
      "gradients": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": false
      }
    }
  },
  "textdomain": "benefits-grid",
  "viewScript": "file:./view.js",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
